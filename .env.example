# AppleCalendar Environment Configuration
# Copy this file to .env and fill in the values

# ─── Database ───
# Development (SQLite):
DATABASE_URL="file:./db/custom.db"
# Production (PostgreSQL) — uncomment and configure:
# DATABASE_URL="postgresql://applecalendar:CHANGE_ME@localhost:5432/applecalendar?schema=public"

# ─── Authentication ───
# REQUIRED: A strong random secret for JWT token signing (min 32 characters)
# NEVER use the default value in production
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-strong-random-secret

# ─── Platform ───
# Default currency (ISO 4217) — GHS for Ghana
DEFAULT_CURRENCY=GHS
# Platform fee percentage (e.g., 5 = 5%)
PLATFORM_FEE_PERCENT=5

# ─── Application ───
# Application URL (used for CORS, redirects)
APP_URL=http://localhost:3000

# ─── CORS ───
# Allowed origins (comma-separated, no spaces between origins)
# Development: http://localhost:3000
# Production example: https://app.applecalendar.com,https://www.applecalendar.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Paystack (Phase 5E+) ───
# REQUIRED in production. Use sk_test_ keys for sandbox/testing.
# NEVER commit actual keys. Use environment variables only.
# PAYSTACK_SECRET_KEY=          # Server-side API key (sk_test_ or sk_live_)
# PAYSTACK_PUBLIC_KEY=          # Client-side key (pk_test_ or pk_live_)
# PAYSTACK_BASE_URL=https://api.paystack.co  # API base URL (same for test/live)
# PAYSTACK_WEBHOOK_SECRET=      # Webhook signature verification secret
# PAYMENT_EXPIRY_MINUTES=15     # Minutes before unpaid payment expires

# ─── Reserved for Future Phases ───
# REDIS_URL=                    # Rate limiting (multi-instance)
# S3_BUCKET=                    # Media storage (Phase 5F+)
# SMTP_HOST=                    # Email (Phase 5G+)
# SMTP_PORT=                    # Phase 5G+
# SMTP_USER=                    # Phase 5G+
# SMTP_PASS=                    # Phase 5G+
